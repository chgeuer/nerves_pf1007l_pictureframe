# Custom U-Boot base environment for Nerves (Allwinner A33 PF1007L)

nerves_fw_active=a
nerves_fw_autovalidate=1
nerves_fw_validated=1
nerves_fw_booted=0

nerves_revert=    if test ${nerves_fw_active} = "a"; then        echo "Reverting to partition B";        setenv nerves_fw_active "b";    else        echo "Reverting to partition A";        setenv nerves_fw_active "a";    fi

nerves_init=    if test ${nerves_fw_booted} = 1; then        if test ${nerves_fw_validated} = 0 && test ${nerves_fw_autovalidate} = 0; then            run nerves_revert;            setenv nerves_fw_validated 1;            saveenv;        fi;    else        setenv nerves_fw_booted 1;        if test ${nerves_fw_autovalidate} = 1; then            setenv nerves_fw_validated 1;        fi;        saveenv;    fi;    if test ${nerves_fw_active} = "a"; then        setenv uenv_root /dev/mmcblk0p2;        setenv uenv_part 2;    else        setenv uenv_root /dev/mmcblk0p3;        setenv uenv_part 3;    fi

devtype=mmc
devnum=0
bootlimit=1
upgrade_available=0
bootcount=0
kernel_addr_r=0x42000000
fdt_addr_r=0x43000000
scriptaddr=0x43100000
pxefile_addr_r=0x43200000
ramdisk_addr_r=0x43300000

uname_boot=setenv bootargs console=ttyS0,115200 root=${uenv_root} rootfstype=squashfs rootwait; if sqfsload ${devtype} ${devnum}:${uenv_part} ${kernel_addr_r} /boot/zImage && sqfsload ${devtype} ${devnum}:${uenv_part} ${fdt_addr_r} /boot/sun8i-a33-pf1007l.dtb; then setenv uboot_stage bootz_sqfs; saveenv; bootz ${kernel_addr_r} - ${fdt_addr_r}; elif fatload ${devtype} ${devnum}:1 ${kernel_addr_r} zImage && fatload ${devtype} ${devnum}:1 ${fdt_addr_r} sun8i-a33-pf1007l.dtb; then setenv uboot_stage bootz_fat; saveenv; bootz ${kernel_addr_r} - ${fdt_addr_r}; else setenv uboot_stage load_failed; saveenv; fi

nerves_boot=run nerves_init uname_boot
bootcmd=run nerves_boot
