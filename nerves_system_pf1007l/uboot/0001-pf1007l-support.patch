+++ b/arch/arm/dts/sun8i-a33-pf1007l.dts
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Device Tree for AEEZO PF1007L (Allwinner A33, Q8 A33 base, no PMIC)
+ */
+
+#include "sun8i-a33-q8-tablet.dts"
+
+/ {
+	model = "AEEZO PF1007L Digital Photo Frame";
+	aliases {
+		mmc0 = &mmc0;
+	};
+};
+
+&mmc0 {
+	/delete-property/ cd-gpios;
+	broken-cd;
+	status = "okay";
+};
+
+&mmc1 {
+	status = "disabled";
+};
+
+&usb_otg {
+	dr_mode = "peripheral";
+};
+
+&usbphy {
+	/delete-property/ usb0_vbus-supply;
+	/delete-property/ usb0_id_det-gpios;
+};
