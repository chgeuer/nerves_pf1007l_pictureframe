# Additional configuration for erlinit

# Use the hardware UART (ttyS0) by default so Scenic owns the 800x1280 MIPI-DSI framebuffer.
-c ttyS0

--warn-unused-tty
-s "/usr/bin/nbtty"

-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Mount the application partition (mmcblk0p4 F2FS)
-m /dev/mmcblk0p4:/root:f2fs:nodev:

-r /srv/erlang
-d /usr/bin/boardid
-n nerves-%-.8s
--boot shoehorn
